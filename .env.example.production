# ==============================================================================
# Plantilla de variables de entorno para PRODUCCIÓN (Docker + Cloudflare Tunnel).
#
# Copiar a .env.production y rellenar los valores reales:
#   cp .env.example.production .env.production
#
# NOTA: docker-compose interpola ${...} con `docker compose --env-file .env.production`.
#       La aplicación lee este mismo archivo montado en /var/www/.env.
# ==============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_NAME="Nomina SM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Dominio público (a través de Cloudflare). Es el origen de passkeys/WebAuthn y
# de los enlaces generados (restablecimiento de contraseña, verificación, etc.).
APP_URL=https://nomina.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Modo mantenimiento distribuido (usa Redis para que `php artisan down` sea global)
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# --- Despliegue ---------------------------------------------------------------
# Puerto del host donde escucha nginx (origen del túnel de Cloudflare).
# Enlaza a 0.0.0.0, por lo que es alcanzable en http://<ip-privada>:8080.
WEB_PORT=8080

# --- Logs ---------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# --- Base de datos (MySQL 8) --------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nominas_sm
DB_USERNAME=nominas
DB_PASSWORD=

# Contraseña root de MySQL (la usa el contenedor `db`, no la aplicación)
MYSQL_ROOT_PASSWORD=

# --- Sesión / Cache / Colas (Redis) -------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_CONNECTION=default
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache

# --- Colas / Broadcast / Archivos ---------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo (SMTP genérico para Fortify: reset de contraseña y verificación) ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_SCHEME=null  -> STARTTLS (puerto 587). Usar "smtps" para SSL (puerto 465).
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="Nomina SM"

# --- Seguridad ----------------------------------------------------------------
# Redirige a HTTPS y emite cabeceras endurecidas. Con Cloudflare Tunnel el
# tráfico llega como HTTP local, pero se marca seguro vía X-Forwarded-Proto.
SECURITY_FORCE_HTTPS=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

# CSP: opcional. Si se activa, revisar que los recursos inline de Vite funcionen.
SECURITY_CSP_ENABLED=false

# Proxies de confianza: cloudflared termina TLS y reenvía la IP real del cliente.
# Al exponer el origen por la IP privada del host, se confía en cualquier proxy
# (0.0.0.0/0) para recuperar la IP real y que el rate-limiting funcione.
# SEGURO únicamente si el puerto WEB_PORT no está abierto a internet (ver
# DEPLOYMENT.md, nota de firewall).
TRUSTED_PROXIES=0.0.0.0/0

# --- SSR de Inertia (servicio Node dedicado) ----------------------------------
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

# --- Passkeys / WebAuthn ------------------------------------------------------
# Secreto para los user handles de WebAuthn. Generar uno aleatorio y estable
# (por ejemplo: openssl rand -base64 32). Si se omite, usa APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=
